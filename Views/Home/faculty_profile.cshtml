@model SPC_Faculty_Pages.Models.Database.Faculty

@{
    Layout = "_layout";
}


<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Faculty Profile - @Model.FirstName @Model.LastName</title>
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    </head>
    <body>
        <header class="site-header">
            <div class="header-content">
                <p class="school-name">College Faculty Directory</p>
                <nav>
                    <a asp-controller="Home" asp-action="Index">Campus Selection</a>
                    <a asp-controller="Home"
                       asp-action="FacultyInformationCollection"
                       asp-route-id="@Model.FacultyId">Edit Profile</a>
                </nav>
            </div>
        </header>

        <main class="profile-page">
            <section class="profile-top">
                <div class="instructor-photo">Instructor Image</div>
                <div>
                    <p>@(string.IsNullOrWhiteSpace(Model.OfficeLocation) ? "Campus not listed" : Model.OfficeLocation) - @Model.Department.DepartmentName</p>
                    <h1>@Model.FirstName @Model.LastName</h1>
                    <p>Office: @(string.IsNullOrWhiteSpace(Model.OfficeLocation) ? "Not listed" : Model.OfficeLocation)</p>
                    <p>Email: <a href="mailto:@Model.Email">@Model.Email</a></p>
                    <p>Phone: @(string.IsNullOrWhiteSpace(Model.Phone) ? "Not listed" : Model.Phone)</p>
                </div>
            </section>

            <section class="biography">
                <h2>Biography</h2>
                <p>
                    @(string.IsNullOrWhiteSpace(Model.Biography) ? "Biography not available." : Model.Biography)
                </p>
            </section>

            <section class="enrollments">
                <h2>Enrollments</h2>
                <ul class="course-list">
                    @if (Model.Facultycourses.Any())
                    {
                        @foreach (var enrollment in Model.Facultycourses.OrderBy(fc => fc.Course.CourseCode))
                        {
                            <li>
                                <strong>@enrollment.Course.CourseCode</strong>
                                <span>@enrollment.Course.CourseTitle @(enrollment.Term == null ? "" : $"({enrollment.Term})")</span>
                            </li>
                        }
                    }
                    else
                    {
                        <li><span>No courses assigned.</span></li>
                    }
                </ul>
            </section>
            <p class="back-link"><a asp-controller="Home" asp-action="Index">← Back to Faculty Profiles</a></p>
        </main>

    </body>
</html>
