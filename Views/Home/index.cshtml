@model IEnumerable<SPC_Faculty_Pages.Models.Database.Faculty>

@{
    Layout = "_layout";
}

<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Faculty Profiles</title>
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    </head>
    <body>
        <header class="site-header">
            <div class="header-content">
                <p class="school-name">College Faculty Directory</p>
                <nav aria-label="Main navigation">
                    <a asp-controller="Home" asp-action="Index" aria-current="page">Faculty Profiles</a>
                    <a asp-controller="Home" asp-action="FacultyProfile">Instructor Profile</a>
                    <a asp-controller="Home" asp-action="FacultyInformationCollection">Edit Profile</a>
                </nav>
            </div>
        </header>

        <main class="directory">
            <h1>Faculty Profiles</h1>
            <p>Browse faculty by campus and view instructor information.</p>

            <section class="campus-grid" aria-label="Campus locations">
                <a class="campus-card" asp-controller="Home" asp-action="FacultyListASC">
                    <img class="campus-image" src="~/images/allstate.jpg" alt="All State Center" asp-append-version="true" />
                    <h2>All State Center</h2>
                </a>

                <a class="campus-card" asp-controller="Home" asp-action="FacultyListCL">
                    <img class="campus-image" src="~/images/clearwater.jpg" alt="Clearwater campus" asp-append-version="true" />
                    <h2>Clearwater</h2>
                </a>

                <a class="campus-card" asp-controller="Home" asp-action="FacultyListDT">
                    <img class="campus-image" src="~/images/downtown.jpg" alt="Downtown campus" asp-append-version="true" />
                    <h2>Downtown</h2>
                </a>

                <a class="campus-card" asp-controller="Home" asp-action="FacultyListHEC">
                    <img class="campus-image" src="~/images/hec.jpg" alt="Health Education Center" asp-append-version="true" />
                    <h2>Health Education Center</h2>
                </a>

                <a class="campus-card" asp-controller="Home" asp-action="FacultyListSC">
                    <img class="campus-image" src="~/images/seminole.jpg" alt="Seminole campus" asp-append-version="true" />
                    <h2>Seminole Campus</h2>
                </a>

                <a class="campus-card" asp-controller="Home" asp-action="FacultyListEP">
                    <img class="campus-image" src="~/images/epicenter.jpg" alt="Epicenter" asp-append-version="true" />
                    <h2>Epicenter</h2>
                </a>

                <a class="campus-card" asp-controller="Home" asp-action="FacultyListGB">
                    <img class="campus-image" src="~/images/gibbs.jpg" alt="Gibbs campus" asp-append-version="true" />
                    <h2>Gibbs Campus</h2>
                </a>

                <a class="campus-card" asp-controller="Home" asp-action="FacultyListTP">
                    <img class="campus-image" src="~/images/tarpon.jpg" alt="Tarpon Springs campus" asp-append-version="true" />
                    <h2>Tarpon Campus</h2>
                </a>
            </section>

            
        </main>
    
    </body>
</html>
